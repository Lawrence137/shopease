
generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  price       Int
  category    String
  image       String
  stock       Int      @default(10)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
